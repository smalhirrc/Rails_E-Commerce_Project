<div>
    <% if @product.image.attached? %>
        <div>
            <%= image_tag url_for(@product.image), alt: @product.name %>
        </div>
    <% else %>
        <div>
            <p>No image Available</p>
        </div>
    <% end %>

    <%= render "products/category" %>

    <%= render "products/product" %>

    <%= render "products/add_to_cart" %>
</div>