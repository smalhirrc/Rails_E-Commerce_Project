<hr>
<% if @cart.count <= 0 %>
    <div id="empty_cart_container">
        <p>Cart is empty</p>
    </div>
<% else %>
    <div id="checkout_button_container">
        <%= button_to "Go to Checkout", "/cart/checkout", method: :get %>
    </div>

    <div id="shopping_cart">
        <% @cart.each do |product_id, quantity| %>
            <div id="shoping_cart_item">
                <div>
                    <h3><%= Product.find(product_id).name %></h3>
                    <p>Quantity: <%= quantity %></p>
                </div>

                <div>
                    <%= form_with url: "/edit_cart/#{product_id}", method: :post do |form| %>
                        <%= form.text_field :new_quantity, value: quantity %>
                        <%= form.submit "Change Quantity" %>
                    <% end %>
                    <%= button_to "Remove Item", "/cart/remove/#{product_id}" %>
                </div>
            </div>
            <hr>
        <% end %>
    </div>
<% end %>