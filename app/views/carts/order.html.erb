<div>
    <h1>Order successful. Thanks for ordering with us.</h1>
</div>
<div id="invoice_container">
    <table>
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Units</th>
                <th>Price per unit</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            <% @order_items.each do |item| %>
                <tr>
                    <td><%= item.product&.name %></td>
                    <td><%= item.quantity %></td>
                    <td><%= item.price %></td>
                    <td><%= item.price * item.quantity %></td>
                </tr>
            <% end %>
        </tbody>
    </table>
    <hr>

    <div id="invoice_total_container">
        <table>
            <tbody>
                <tr>
                    <td>Total: </td>
                    <td><%= @total %></td>
                </tr>
                <tr>
                    <td>Tax: </td>
                    <td><%= @tax %></td>
                </tr>
                <tr>
                    <td>Sub-Total</td>
                    <td><%= @grand_total %></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>