<%= form_with url: "/findorders", method: :post do |form| %>
    <fieldset>
        <%= form.label :customer_id, "Customer ID " %>
        <%= form.text_field :customer_id, value: params[:customer_id] %>
        </fieldset>
    <%= form.submit "Find Orders" %>
<% end %>
<div>
  <% if request.post? %>
    
    <% if @orders.any? %>
      <h2>Order History</h2>
      
      <% @orders.each do |order| %>
        <article>
          <header>
            <div>
              <span>Order Number</span>
              <strong><%= order.id %></strong>
            </div>
            <div>
              <span>Date Placed</span>
              <span><%= order.created_at.strftime("%B %d, %Y") %></span>
            </div>
            <% if order.respond_to?(:total_price) %>
              <div>
                <span>Total Amount</span>
                <strong>$<%= number_with_precision(order.total_price, precision: 2) %></strong>
              </div>
            <% end %>
          </header>
          <section>
            <h3>Items in this order</h3>
            <ul>
              <% grand_total = 0 %>
              <% order.order_items.each do |order_item| %>
                <li>
                  <span><%= order_item.product.name %></span>
                  <% grand_total += order_item.price %>

                  <% if order_item.respond_to?(:quantity) %>
                    <span>(Qty: <%= order_item.quantity %>)</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
            <p>Grand total : <%= grand_total + grand_total * order.customer.province.tax %></p>
            <p>Taxes : <%= grand_total * order.customer.province.tax %></p>
            <hr>
          </section>

        </article>
      <% end %>

    <% else %>
      <div>
        <p>No orders found for this customer.</p>
      </div>
    <% end %>

  <% end %>
</div>
