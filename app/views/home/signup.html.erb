<main>
    <div id="signup_form_container">
        <%= form_with url: "/signup", method: :post do |form| %>
            <fieldset>
                <legend>Profile</legend>
                    <ul>
                        <li>
                            <%= form.label :user_email, "Email: " %>
                            <%= form.email_field :user_email %>
                        </li>
                        <li>
                            <%= form.label :password, "Password: " %>
                            <%= form.password_field :password %>
                        </li>
                        <li>
                            <%= form.label :province_id, "Province: " %>
                            <%= form.collection_select :province_id, @provinces, :id, :name %>
                        </li>
                        <li>
                            <%= form.label :user_city, "City: " %>
                            <%= form.text_field :user_city %>
                        </li>
                        <li>
                            <%= form.label :user_street_address, "Street Address: " %>
                            <%= form.text_field :user_street_address %>
                        </li>
                        <li>
                            <%= form.label :user_postal_code, "Postal Code: " %>
                            <%= form .text_field :user_postal_code %>
                        </li>
                    </ul>
            </fieldset>
            <%= button_to "Sign Up", "/signup" %>
        <% end %>
    </div>
</main>